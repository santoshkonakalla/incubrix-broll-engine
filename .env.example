# ==============================================================================
# IncuBrix Assessment 3 — Script & Voiceover to B-roll Video Engine
# Copy this file to .env and fill in real keys for live mode.
# Leave ADAPTER_MODE=mock to run everything & all tests with ZERO API keys.
# ==============================================================================

# --- Service & Security ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=30
WEBHOOK_HMAC_SECRET=incubrix-dev-webhook-secret
PUBLIC_BASE_URL=http://localhost:8000

# --- Adapter Mode ("mock" for zero-key offline/tests, "live" for real APIs) ---
ADAPTER_MODE=mock
ASR_PROVIDER=mock
TTS_PROVIDER=mock
PLANNER_PROVIDER=mock
VLM_SCORER_PROVIDER=mock
FOOTAGE_SOURCES=pexels,pixabay,generative,statcard
DISABLED_SOURCES=

# --- External API Keys (only needed when ADAPTER_MODE=live) ---
GEMINI_API_KEY=
GROQ_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Model Configuration (no hardcoded model names in code) ---
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Pipeline Limits & Quality Rules ---
MAX_AUDIO_DURATION_SECONDS=600
MAX_UPLOAD_MB=100
MIN_SCENE_DURATION_SECONDS=2.5
MAX_SCENE_DURATION_SECONDS=9.0
STOCK_MIN_RELEVANCE_SCORE=3.5
TARGET_FPS=30
COLOR_NORMALIZE_ENABLED=true
DEFAULT_SEED=42
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=600

# --- Infrastructure (Database, Queue, S3/MinIO Storage) ---
DATABASE_URL=sqlite:///./.local_storage/incubrix.db
REDIS_URL=
QUEUE_BACKEND=inline
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.local_storage
TEMP_WORK_DIR=./.tmp_jobs

# --- S3 / MinIO Settings (used when STORAGE_BACKEND=s3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=incubrix-broll
S3_REGION=us-east-1
